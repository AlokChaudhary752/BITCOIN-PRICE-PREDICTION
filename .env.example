# BTC Oracle Environment Configuration Template

# Server & Environment
ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/btcoracle
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=production_super_secret_jwt_key_at_least_32_chars_long_randomized
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data & ML Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
BINANCE_API_URL=https://api.binance.com
ALTERNATIVE_ME_API_URL=https://api.alternative.me

# Monitoring & Instrumentation
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
